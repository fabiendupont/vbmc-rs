FROM registry.access.redhat.com/ubi9/ubi as builder

RUN dnf install -y gcc make openssl-devel && dnf clean all

RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain stable
ENV PATH="/root/.cargo/bin:${PATH}"

WORKDIR /build
COPY . .

RUN cargo build --release --features "cloud-hypervisor,qemu,kubevirt,aggregator"

FROM registry.access.redhat.com/ubi9/ubi-minimal

COPY --from=builder /build/target/release/vbmc-rs /usr/local/bin/vbmc-rs
COPY --from=builder /build/target/release/vbmc-rs-aggregator /usr/local/bin/vbmc-rs-aggregator

EXPOSE 8000
ENTRYPOINT ["/usr/local/bin/vbmc-rs"]
CMD ["-c", "/etc/vbmc-rs/config.toml"]
